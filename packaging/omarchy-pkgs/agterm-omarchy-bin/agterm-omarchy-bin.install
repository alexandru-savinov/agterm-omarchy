# shellcheck shell=bash
post_install() {
    echo "For Omarchy's Super+C and Super+V shortcuts, run agtermctl integration omarchy enable as your desktop user."
    echo 'To enable Claude Code status hooks, run as your desktop user: /usr/bin/agtermctl integration install hooks --only claude'
}

post_upgrade() {
    echo 'To enable Claude Code status hooks, run as your desktop user: /usr/bin/agtermctl integration install hooks --only claude'
}

pre_remove() {
    echo 'To clean up configured Claude Code status hooks, reinstall agterm or delete the entries by hand.'
    echo 'After reinstalling, run as your desktop user: /usr/bin/agtermctl integration uninstall hooks --only claude'
}
