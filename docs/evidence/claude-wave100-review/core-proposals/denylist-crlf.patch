+    @Test func denylistLineEndingsDoNotPermitDeniedRestores() {
+        for newline in ["\n", "\r\n", "\r"] {
+            let text = ["# programs not to restore", "", " tmux ", "screen", "# ignored", "zellij", ""]
+                .joined(separator: newline)
+            let denied = CommandRestore.parseDenylist(text)
+            #expect(denied == ["tmux", "screen", "zellij"])
+            #expect(!CommandRestore.shouldRestore(argv: ["/usr/bin/tmux", "new"], denylist: denied))
+            #expect(!CommandRestore.shouldRestore(argv: ["screen"], denylist: denied))
+            #expect(CommandRestore.shouldRestore(argv: ["top"], denylist: denied))
+        }
+        // Without an initial comment, CRLF must not combine several basenames into one entry.
+        let denied = CommandRestore.parseDenylist("tmux\r\nscreen\r\n")
+        #expect(denied == ["tmux", "screen"])
+        #expect(!CommandRestore.shouldRestore(argv: ["tmux"], denylist: denied))
+        #expect(CommandRestore.parseDenylist("# comments only\r\n\r\n").isEmpty)
+        #expect(CommandRestore.parseDenylist("tmux\r\nscreen\nzellij\r") == ["tmux", "screen", "zellij"])
+    }
