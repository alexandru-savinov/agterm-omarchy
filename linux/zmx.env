# Pinned zmx input shared by Linux setup, cache verification, and release CI.
ZMX_REPO="https://github.com/neurosnap/zmx"
# main after v1.0.1: carries #316, which stops a daemon shutdown from freeing the caller's socket path.
ZMX_REV="232f1a218e8e4b7a580087c3834ac5dd038254dc"
# The Zig release zmx's build.zig.zon requires; recorded in the cache stamp with the commit and patches.
ZMX_ZIG_VERSION="0.17.0"
# Distributable helpers must not inherit the build runner's CPU extensions.
ZMX_CPU="baseline"
# The Ghostty commit zmx's build.zig.zon declares at ZMX_REV. zmx's own content hash for it is replaced
# by a local path (scripts/zmx-patches), so setup fetches this exact commit and refuses any other.
ZMX_GHOSTTY_PIN="53e55147bbbb0157672dac0228aa7744e881f1fa"
