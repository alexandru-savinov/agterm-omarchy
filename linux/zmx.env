# Pinned zmx input shared by Linux setup, cache verification, and release CI.
ZMX_REPO="https://github.com/neurosnap/zmx"
ZMX_REV="8bab1f0173b07e79835ea372d749af3dbf0d0842"
# Distributable helpers must not inherit the build runner's CPU extensions.
ZMX_CPU="baseline"
# SHA-256 of the codeload.github.com source archives setup-linux.sh downloads. zmx's own content hash
# for its Ghostty dependency is replaced by a local path (scripts/zmx-patches), so these pins are the
# integrity check for both archives. Recompute by downloading the exact URLs:
#   https://codeload.github.com/neurosnap/zmx/tar.gz/$ZMX_REV
#   https://codeload.github.com/ghostty-org/ghostty/tar.gz/$ZMX_GHOSTTY_PIN
ZMX_SHA256="4929008140cd66ea29d5c7504c59198a82ec793e635b70bd0ece5aac2cad1767"
# The Ghostty revision zmx's build.zig.zon declares at ZMX_REV; setup refuses any other.
ZMX_GHOSTTY_PIN="8af6897c0afc63037a8a3efee4162a380e3a4572"
ZMX_GHOSTTY_SHA256="3e40f95234e1d126679bc260ad68146f63e36f4749a829d334a43653964cacea"
