+fn environmentUnsetSlice(names: ?[*]const ?[*:0]const u8, count: usize) ![]const ?[*:0]const u8 {
+    if (count == 0) return &.{};
+    if (count > std.math.maxInt(usize) / @sizeOf(?[*:0]const u8)) return error.InvalidEnvironmentNames;
+    return (names orelse return error.InvalidEnvironmentNames)[0..count];
+}
+
+fn copyEnvironmentUnsets(alloc: Allocator, unset: []const ?[*:0]const u8) ![]const [*:0]const u8 {
+    const names = try alloc.alloc([*:0]const u8, unset.len);
+    for (unset, 0..) |name, i| {
+        const value = std.mem.span(name orelse return error.InvalidEnvironmentName);
+        if (value.len == 0 or std.mem.indexOfScalar(u8, value, '=') != null)
+            return error.InvalidEnvironmentName;
+        names[i] = try alloc.dupeZ(u8, value);
+    }
+    return names;
+}
+
+test "environment deletion boundary preserves empty lists and rejects invalid pointers/counts" {
+    try std.testing.expectEqual(@as(usize, 0), (try environmentUnsetSlice(null, 0)).len);
+    try std.testing.expectError(error.InvalidEnvironmentNames, environmentUnsetSlice(null, 1));
+    const names = [_]?[*:0]const u8{"A"};
+    try std.testing.expectEqual(@as(usize, 1), (try environmentUnsetSlice(&names, 1)).len);
+    try std.testing.expectError(error.InvalidEnvironmentNames, environmentUnsetSlice(&names, std.math.maxInt(usize)));
+}
+
+test "environment deletion names are owned and validated" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    var source = [_:0]u8{'A'};
+    const names = try copyEnvironmentUnsets(arena.allocator(), &.{&source});
+    source[0] = 'B';
+    try std.testing.expectEqualStrings("A", std.mem.span(names[0]));
+    try std.testing.expectError(error.InvalidEnvironmentName, copyEnvironmentUnsets(arena.allocator(), &.{null}));
+    try std.testing.expectError(error.InvalidEnvironmentName, copyEnvironmentUnsets(arena.allocator(), &.{""}));
+    try std.testing.expectError(error.InvalidEnvironmentName, copyEnvironmentUnsets(arena.allocator(), &.{"A=B"}));
+}
+
+test "environment deletion allocation failures release the owning arena" {
+    const Check = struct {
+        fn run(allocator: Allocator) !void {
+            var arena = std.heap.ArenaAllocator.init(allocator);
+            defer arena.deinit();
+            const names = try copyEnvironmentUnsets(arena.allocator(), &.{ "LD_LIBRARY_PATH", "AGTERM_ORIG_SET" });
+            try std.testing.expectEqualStrings("LD_LIBRARY_PATH", std.mem.span(names[0]));
+            try std.testing.expectEqualStrings("AGTERM_ORIG_SET", std.mem.span(names[1]));
+        }
+    };
+    try std.testing.checkAllAllocationFailures(std.testing.allocator, Check.run, .{});
+}
