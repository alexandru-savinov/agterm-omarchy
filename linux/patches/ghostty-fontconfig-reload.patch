+/// Refresh Fontconfig on the app thread before rebuilding its surfaces.
+pub fn reloadFontconfigIfStale(self: *SharedGridSet) void {
+    if (comptime Discover == discovery.Fontconfig) {
+        // Once initialized, discovery remains alive until this app is destroyed.
+        const disco = disco: {
+            self.lock.lockUncancelable(global.io());
+            defer self.lock.unlock(global.io());
+            break :disco if (self.font_discover) |*value| value else return;
+        };
+        const prepared = disco.prepareConfigReload() catch |err| {
+            log.warn("failed to reload Fontconfig err={}", .{err});
+            return;
+        };
+        const next = prepared orelse return;
+        const previous = previous: {
+            self.lock.lockUncancelable(global.io());
+            defer self.lock.unlock(global.io());
+            // Install the new snapshot and invalidate old grid keys together.
+            self.discovery_generation +%= 1;
+            break :previous disco.replaceConfig(next);
+        };
+        previous.destroy();
+    }
