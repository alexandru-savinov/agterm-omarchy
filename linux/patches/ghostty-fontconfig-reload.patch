+/// Refresh Fontconfig before an application config reload rebuilds its surfaces.
+pub fn reloadFontconfigIfStale(self: *SharedGridSet) void {
+    if (comptime Discover == discovery.Fontconfig) {
+        self.lock.lockUncancelable(global.io());
+        defer self.lock.unlock(global.io());
+        const disco = if (self.font_discover) |*value| value else return;
+        const changed = disco.reloadIfStale() catch |err| {
+            log.warn("failed to reload Fontconfig err={}", .{err});
+            return;
+        };
+        // New lookups must bypass the old grids. Renderers still using them
+        // release them through their existing reference-counted lifetime.
+        if (changed) self.discovery_generation +%= 1;
+    }
