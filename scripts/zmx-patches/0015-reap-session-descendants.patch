new file mode 100644
index 0000000..7830c11
--- /dev/null
+++ b/src/child_reaper.zig
@@ -0,0 +1,61 @@
+const std = @import("std");
+const linux = std.os.linux;
+const lib_posix = @import("posix.zig");
+const role = @import("role.zig");
+
+/// Start before forkpty so an orphaned session descendant is adopted by the daemon, even in a
+/// container whose PID 1 never waits for adopted children.
+pub fn becomeSubreaper() void {
+    const rc = linux.prctl(@backingInt(linux.PR.SET_CHILD_SUBREAPER), 1, 0, 0, 0);
+    const err = linux.errno(rc);
+    if (err != .SUCCESS) std.log.warn("cannot adopt orphaned session children: {s}", .{@tagName(err)});
+}
+
+/// Watch SIGCHLD after forkpty so the shell retains its original signal mask.
+pub fn openSignalFd() !lib_posix.fd_t {
+    var mask = lib_posix.sigemptyset();
+    std.posix.sigaddset(&mask, .CHLD);
+    const fd = try std.posix.signalfd(-1, &mask, linux.SFD.CLOEXEC | linux.SFD.NONBLOCK);
+    std.posix.sigprocmask(linux.SIG.BLOCK, &mask, null);
+    return fd;
+}
+
+pub fn handleSignal(fd: lib_posix.fd_t, shell_pid: i32) void {
+    var event: linux.signalfd_siginfo = undefined;
+    _ = lib_posix.read(fd, std.mem.asBytes(&event)) catch return;
+    reapExited(shell_pid);
+}
+
+/// Reap exited orphans during the session. Keep the shell's PID reserved until the last
+/// process-group signal has been sent, even if the shell has already exited.
+pub fn reapExited(shell_pid: i32) void {
+    while (true) {
+        var info = std.mem.zeroes(linux.siginfo_t);
+        const rc = linux.waitid(.ALL, 0, &info, linux.W.EXITED | linux.W.NOHANG | linux.W.NOWAIT, null);
+        switch (linux.errno(rc)) {
+            .SUCCESS => {},
+            .INTR => continue,
+            else => return,
+        }
+        const pid = info.fields.common.first.piduid.pid;
+        if (pid == 0 or pid == shell_pid) return;
+        _ = lib_posix.waitpid(pid, 0);
+    }
+}
+
+/// After SIGKILL and the shell wait, collect the killed workers in the same group. Bound the
+/// wait in case a worker cannot finish exiting, and avoid waiting on jobs outside the group.
+pub fn reapGroup(shell_pid: i32, io: std.Io) void {
+    const deadline = role.nowMs() + 250;
+    while (role.nowMs() < deadline) {
+        var status: i32 = undefined;
+        const rc = linux.waitpid(-shell_pid, &status, linux.W.NOHANG);
+        switch (linux.errno(rc)) {
+            .SUCCESS => if (rc == 0) {
+                std.Io.sleep(io, std.Io.Duration.fromMilliseconds(5), .awake) catch return;
+            },
+            .INTR => continue,
+            else => return,
+        }
+    }
+}
