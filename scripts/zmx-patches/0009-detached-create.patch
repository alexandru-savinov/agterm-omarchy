+test "parseAttachArgs reads --detached before the session name only" {
+    const argv: []const []const u8 = &.{ "--detached", "dev", "sh", "--detached" };
+    const parsed = parseAttachArgs(argv);
+    try std.testing.expect(parsed.detached);
+    try std.testing.expectEqualStrings("dev", parsed.session_name);
+    // --detached after the session name belongs to the command.
+    try std.testing.expectEqualSlices([]const u8, argv[2..], argv[parsed.command_start..]);
+    try std.testing.expect(!parseAttachArgs(&.{"dev"}).detached);
