+test "a client sent everything leaves a draining session while a stalled one holds it" {
+    const alloc = std.testing.allocator;
+    var s: EndingSession = undefined;
+    try s.start(alloc, .{ .drain_ms = 20_000, .with_reader = true });
+    defer s.deinit();
+    const payload = try testPayload(alloc);
+    defer alloc.free(payload);
+
+    // the reader keeps reading from before the exit; the session socket is never read
+    var got: std.ArrayList(u8) = .empty;
+    defer got.deinit(alloc);
+    var frames = try ipc.SocketBuffer.init(alloc);
+    defer frames.deinit();
+    const Reader = struct {
+        fn run(fd: i32, buffer: *ipc.SocketBuffer, out: *std.ArrayList(u8), a: std.mem.Allocator, eof_ms: *std.atomic.Value(i64)) void {
+            while (true) {
+                const n = buffer.read(fd) catch 0;
+                if (n == 0) break;
+                while (buffer.next()) |msg| {
+                    if (msg.header.tag == .Output) out.appendSlice(a, msg.payload) catch @panic("out of memory");
+                }
+            }
+            eof_ms.store(role.nowMs(), .release);
+        }
+    };
+    var eof_ms = std.atomic.Value(i64).init(0);
+    const reader = try std.Thread.spawn(.{}, Reader.run, .{ s.reader, &frames, &got, alloc, &eof_ms });
+    defer reader.join();
+
+    const began = role.nowMs();
+    try s.shellPrintsAndExits(payload);
+    EndingSession.waitFor(&eof_ms);
+    // let go well before the deadline, while the stalled client still holds the daemon
+    try std.testing.expect(!EndingSession.done(&s.daemon_done_ms));
+    try tookWithin("reader", eof_ms.load(.acquire) - began, test_exit_drain_ms, 0, @divTrunc(test_exit_drain_ms, 2));
+    try std.testing.expect(std.mem.endsWith(u8, got.items, EndingSession.final_mark));
+}
