+test "a header from another protocol version marks the peer foreign" {
+    var sb = try SocketBuffer.init(std.testing.allocator);
+    defer sb.deinit();
+    var header = std.mem.zeroes(Header);
+    header.tag = .Output;
+    header.len = 2;
+    try sb.buf.appendSlice(std.testing.allocator, std.mem.asBytes(&header));
+    try sb.buf.appendSlice(std.testing.allocator, "hi");
+    try std.testing.expect(sb.next() == null);
+    try std.testing.expect(sb.foreign_protocol);
+}
