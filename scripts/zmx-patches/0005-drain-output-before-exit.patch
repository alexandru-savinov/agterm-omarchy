+/// Writes what is still buffered for the terminal before the client exits. stdout is the terminal's pty,
+/// which can be full for a moment when the session ends; poll for room, but never wait past two seconds.
+fn flushStdout(gpa: std.mem.Allocator, out: *std.ArrayList(u8)) void {
+    var fds = [_]lib_posix.pollfd{.{ .fd = lib_posix.STDOUT_FILENO, .events = lib_posix.POLL.OUT, .revents = 0 }};
+    var waits: usize = 0;
+    while (out.items.len > 0 and waits < 200) {
+        const n = lib_posix.write(lib_posix.STDOUT_FILENO, out.items) catch |err| switch (err) {
+            error.WouldBlock => 0,
+            else => return,
+        };
+        if (n > 0) {
+            out.replaceRange(gpa, 0, n, &[_]u8{}) catch return;
+            continue;
+        }
+        _ = lib_posix.poll(&fds, 10) catch return;
+        waits += 1;
+    }
+}
