+
+/// How long a client that lost its daemon keeps draining and flushing the session's last output.
+const HANGUP_DRAIN_MS: i64 = 2000;
+
+/// Writes what is still buffered for the terminal before the client exits, for at most HANGUP_DRAIN_MS.
+/// stdout is made nonblocking for the flush, so a terminal that stops reading cannot hold the client,
+/// and any write error ends it: EPIPE, EIO or EBADF mean the terminal is gone.
+fn flushStdout(gpa: std.mem.Allocator, out: *std.ArrayList(u8)) void {
+    if (out.items.len == 0) return;
+    const fd = lib_posix.STDOUT_FILENO;
+    const flags = lib_posix.fcntl(fd, lib_posix.F.GETFL, 0) catch return;
+    _ = lib_posix.fcntl(fd, lib_posix.F.SETFL, flags | lib_posix.O_NONBLOCK) catch return;
+    defer _ = lib_posix.fcntl(fd, lib_posix.F.SETFL, flags) catch {};
+    const deadline = role.nowMs() + HANGUP_DRAIN_MS;
+    var fds = [_]lib_posix.pollfd{.{ .fd = fd, .events = lib_posix.POLL.OUT, .revents = 0 }};
+    while (out.items.len > 0) {
+        const now = role.nowMs();
+        if (now >= deadline) return;
+        const n = lib_posix.write(fd, out.items) catch |err| switch (err) {
+            error.WouldBlock => 0,
+            else => return,
+        };
+        if (n > 0) {
+            out.replaceRange(gpa, 0, n, &[_]u8{}) catch return;
+            continue;
         }
+        _ = lib_posix.poll(&fds, @intCast(@min(deadline - now, 50))) catch return;
     }
 }
 
