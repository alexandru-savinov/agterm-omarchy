+/// Takes what a read pipeline publishes, as the parse stage does, on its own thread.
+const TestPipelineReader = struct {
+    pipeline: *ReadThread.Pipeline,
+    got: std.ArrayList(u8) = .empty,
+
+    fn run(self: *TestPipelineReader) void {
+        const pipeline = self.pipeline;
+        while (true) {
+            const batch: []const u8 = batch: {
+                pipeline.mutex.lockUncancelable(global.io());
+                defer pipeline.mutex.unlock(global.io());
+                while (pipeline.count == 0) {
+                    if (pipeline.done) return;
+                    pipeline.batch_ready.waitUncancelable(global.io(), &pipeline.mutex);
+                }
+                break :batch pipeline.bufs[pipeline.tail][0..pipeline.lens[pipeline.tail]];
+            };
+            self.got.appendSlice(std.testing.allocator, batch) catch @panic("out of memory");
+            pipeline.mutex.lockUncancelable(global.io());
+            pipeline.tail = (pipeline.tail + 1) % ReadThread.buffer_count;
+            pipeline.count -= 1;
+            pipeline.mutex.unlock(global.io());
+            pipeline.slot_free.signal(global.io());
+        }
+    }
+
+    /// Tells the reader the stream is over, as the gather stage does when it exits.
+    fn finish(self: *TestPipelineReader) void {
+        self.pipeline.mutex.lockUncancelable(global.io());
+        self.pipeline.done = true;
+        self.pipeline.mutex.unlock(global.io());
+        self.pipeline.batch_ready.signal(global.io());
+    }
+};
+
+/// Drains `fd` after a hangup through a pipeline read by a TestPipelineReader; returns what it read.
+fn testHangupDrain(fd: posix.fd_t) !struct { drained: usize, got: std.ArrayList(u8) } {
+    const pipeline = try std.testing.allocator.create(ReadThread.Pipeline);
+    defer std.testing.allocator.destroy(pipeline);
+    pipeline.* = .{};
+    var reader: TestPipelineReader = .{ .pipeline = pipeline };
+    const thread = try std.Thread.spawn(.{}, TestPipelineReader.run, .{&reader});
+    const drained = ReadThread.drainAfterHangup(fd, pipeline);
+    reader.finish();
+    thread.join();
+    return .{ .drained = drained, .got = reader.got };
+}
+
+// regression (agterm-omarchy #447): the read thread returned on POLLHUP without reading, and a Linux
+// master reports POLLHUP as soon as the replica closes, so a child's last output was dropped
+test "a pty whose replica closed with output queued delivers all of that output on the hangup" {
+    if (comptime builtin.os.tag != .linux) return error.SkipZigTest;
+    const pty = try Pty.open(.{ .ws_row = 24, .ws_col = 80, .ws_xpixel = 0, .ws_ypixel = 0 });
+    defer _ = posix.system.close(pty.master);
+
+    // fill the replica until the pty holds no more, with bytes the line discipline passes through
+    var payload: std.ArrayList(u8) = .empty;
+    defer payload.deinit(std.testing.allocator);
+    try std.testing.expect(ReadThread.setNonblock(pty.slave));
+    var chunk: [997]u8 = undefined;
+    for (&chunk, 0..) |*b, i| b.* = 'a' + @as(u8, @intCast(i % 26));
+    while (true) {
+        const rc = posix.system.write(pty.slave, &chunk, chunk.len);
+        if (posix.errno(rc) != .SUCCESS) break;
+        const n: usize = @intCast(rc);
+        try payload.appendSlice(std.testing.allocator, chunk[0..n]);
+    }
+    _ = posix.system.close(pty.slave);
+    try std.testing.expect(payload.items.len > 0);
+
+    // the state the read thread's poll returns in: output queued and the replica gone
+    var pfd = [_]posix.pollfd{.{ .fd = pty.master, .events = posix.POLL.IN, .revents = 0 }};
+    _ = try posix.poll(&pfd, 0);
+    try std.testing.expect(pfd[0].revents & posix.POLL.IN != 0);
+    try std.testing.expect(pfd[0].revents & posix.POLL.HUP != 0);
+
+    try std.testing.expect(ReadThread.setNonblock(pty.master));
+    var result = try testHangupDrain(pty.master);
+    defer result.got.deinit(std.testing.allocator);
+    try std.testing.expectEqual(payload.items.len, result.drained);
+    try std.testing.expectEqualSlices(u8, payload.items, result.got.items);
+}
+
+test "a hangup drain with nothing queued returns at once" {
+    if (comptime builtin.os.tag != .linux) return error.SkipZigTest;
+    const pty = try Pty.open(.{ .ws_row = 24, .ws_col = 80, .ws_xpixel = 0, .ws_ypixel = 0 });
+    defer _ = posix.system.close(pty.master);
+    _ = posix.system.close(pty.slave);
+    try std.testing.expect(ReadThread.setNonblock(pty.master));
+    var result = try testHangupDrain(pty.master);
+    defer result.got.deinit(std.testing.allocator);
+    try std.testing.expectEqual(@as(usize, 0), result.drained);
+}
+
+test "a hangup drain stops at its cap when the fd never runs dry" {
+    if (comptime builtin.os.tag != .linux) return error.SkipZigTest;
+    // /dev/zero always has more to read, as a peer that keeps refilling the pty would
+    const fd = try posix.openatZ(posix.AT.FDCWD, "/dev/zero", .{ .NONBLOCK = true, .CLOEXEC = true }, 0);
+    defer _ = posix.system.close(fd);
+    var result = try testHangupDrain(fd);
+    defer result.got.deinit(std.testing.allocator);
+    try std.testing.expect(result.drained >= ReadThread.hangup_drain_max);
+    try std.testing.expect(result.drained < ReadThread.hangup_drain_max + ReadThread.buffer_capacity);
+    try std.testing.expectEqual(result.drained, result.got.items.len);
+}
