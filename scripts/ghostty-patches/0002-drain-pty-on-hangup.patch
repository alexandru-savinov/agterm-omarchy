+    /// The most a hangup drain reads. A pty queue holds far less, so
+    /// only a peer that keeps refilling the pty reaches it, and then
+    /// the read thread still exits.
+    const hangup_drain_max = 4 * 1024 * 1024;
+
+    /// Reads what is still queued in a pty whose replica side has
+    /// closed and publishes it to the parse stage like any batch,
+    /// until read() reports the queue empty (0 or EAGAIN), the pty
+    /// gone (EIO or any other error), or hangup_drain_max bytes were
+    /// read. Returns how many bytes it published.
+    fn drainAfterHangup(fd: posix.fd_t, pipeline: *Pipeline) usize {
+        var drained: usize = 0;
+        while (drained < hangup_drain_max) {
+            const buf: *[buffer_capacity]u8 = buf: {
+                pipeline.mutex.lockUncancelable(global.io());
+                defer pipeline.mutex.unlock(global.io());
+                while (pipeline.count == buffer_count) {
+                    pipeline.slot_free.waitUncancelable(global.io(), &pipeline.mutex);
+                }
+                break :buf &pipeline.bufs[pipeline.head];
+            };
+            var total: usize = 0;
+            var queued = true;
+            while (total < buffer_capacity) {
+                const n = posix.read(fd, buf[total..]) catch {
+                    queued = false;
+                    break;
+                };
+                if (n == 0) {
+                    queued = false;
+                    break;
+                }
+                total += n;
+            }
+            if (total > 0) {
+                pipeline.mutex.lockUncancelable(global.io());
+                pipeline.lens[pipeline.head] = total;
+                pipeline.head = (pipeline.head + 1) % buffer_count;
+                pipeline.count += 1;
+                pipeline.mutex.unlock(global.io());
+                pipeline.batch_ready.signal(global.io());
+            }
+            drained += total;
+            if (!queued) break;
+        }
+        return drained;
+    }
+
