+/// Takes what a read pipeline publishes, as the parse stage does, on its own thread.
+const TestPipelineReader = struct {
+    pipeline: *ReadThread.Pipeline,
+    got: std.ArrayList(u8) = .empty,
+    received: usize = 0,
+
+    fn run(self: *TestPipelineReader) void {
+        const pipeline = self.pipeline;
+        while (true) {
+            const batch: []const u8 = batch: {
+                pipeline.mutex.lockUncancelable(global.io());
+                defer pipeline.mutex.unlock(global.io());
+                while (pipeline.count == 0) {
+                    if (pipeline.done) return;
+                    pipeline.batch_ready.waitUncancelable(global.io(), &pipeline.mutex);
+                }
+                break :batch pipeline.bufs[pipeline.tail][0..pipeline.lens[pipeline.tail]];
+            };
+            self.received += batch.len;
+            if (self.received <= ReadThread.hangup_drain_max + ReadThread.buffer_capacity) {
+                self.got.appendSlice(std.testing.allocator, batch) catch @panic("out of memory");
+            }
+            pipeline.mutex.lockUncancelable(global.io());
+            pipeline.tail = (pipeline.tail + 1) % ReadThread.buffer_count;
+            pipeline.count -= 1;
+            pipeline.mutex.unlock(global.io());
+            pipeline.slot_free.signal(global.io());
+        }
+    }
+
+    /// Tells the reader the stream is over, as the gather stage does when it exits.
+    fn finish(self: *TestPipelineReader) void {
+        self.pipeline.mutex.lockUncancelable(global.io());
+        self.pipeline.done = true;
+        self.pipeline.mutex.unlock(global.io());
+        self.pipeline.batch_ready.signal(global.io());
+    }
+};
+
+/// Runs `step` on `fd` through a pipeline read by a TestPipelineReader; returns what it read.
+fn testGather(fd: posix.fd_t, comptime step: fn (posix.fd_t, *ReadThread.Pipeline) usize) !struct { drained: usize, received: usize, got: std.ArrayList(u8) } {
+    const pipeline = try std.testing.allocator.create(ReadThread.Pipeline);
+    defer std.testing.allocator.destroy(pipeline);
+    pipeline.* = .{};
+    var reader: TestPipelineReader = .{ .pipeline = pipeline };
+    const thread = try std.Thread.spawn(.{}, TestPipelineReader.run, .{&reader});
+    const drained = step(fd, pipeline);
+    reader.finish();
+    thread.join();
+    return .{ .drained = drained, .received = reader.received, .got = reader.got };
+}
+
+/// The gather stage's decision after its outer poll, on the revents a test polled from a real pty; the
+/// step reports 1 when the stage is done, as on a hangup, else 0.
+const TestHangup = struct {
+    var revents: i16 = 0;
+
+    fn poll(fd: posix.fd_t) !void {
+        var pfd = [_]posix.pollfd{.{ .fd = fd, .events = posix.POLL.IN, .revents = 0 }};
+        _ = try posix.poll(&pfd, 0);
+        revents = pfd[0].revents;
+    }
+
+    fn step(fd: posix.fd_t, pipeline: *ReadThread.Pipeline) usize {
+        return if (ReadThread.hungUp(fd, revents, pipeline)) 1 else 0;
+    }
+};
+
+// regression (agterm-omarchy #447): the read thread returned on POLLHUP without reading, and a Linux
+// master reports POLLHUP as soon as the replica closes, so a child's last output was dropped
+test "a pty whose replica closed with output queued delivers all of that output on the hangup" {
+    if (comptime builtin.os.tag != .linux) return error.SkipZigTest;
+    const pty = try Pty.open(.{ .ws_row = 24, .ws_col = 80, .ws_xpixel = 0, .ws_ypixel = 0 });
+    defer _ = posix.system.close(pty.master);
+
+    // fill the replica until the pty holds no more, with bytes the line discipline passes through
+    var payload: std.ArrayList(u8) = .empty;
+    defer payload.deinit(std.testing.allocator);
+    try std.testing.expect(ReadThread.setNonblock(pty.slave));
+    var chunk: [997]u8 = undefined;
+    for (&chunk, 0..) |*b, i| b.* = 'a' + @as(u8, @intCast(i % 26));
+    while (true) {
+        const rc = posix.system.write(pty.slave, &chunk, chunk.len);
+        if (posix.errno(rc) != .SUCCESS) break;
+        const n: usize = @intCast(rc);
+        try payload.appendSlice(std.testing.allocator, chunk[0..n]);
+    }
+    _ = posix.system.close(pty.slave);
+    try std.testing.expect(payload.items.len > 0);
+
+    // the state the read thread's poll returns in: output queued and the replica gone
+    try TestHangup.poll(pty.master);
+    try std.testing.expect(TestHangup.revents & posix.POLL.IN != 0);
+    try std.testing.expect(TestHangup.revents & posix.POLL.HUP != 0);
+
+    // the gather stage's decision on those revents ends it, with all of the output delivered
+    try std.testing.expect(ReadThread.setNonblock(pty.master));
+    var result = try testGather(pty.master, TestHangup.step);
+    defer result.got.deinit(std.testing.allocator);
+    try std.testing.expectEqual(@as(usize, 1), result.drained);
+    try std.testing.expectEqualSlices(u8, payload.items, result.got.items);
+}
+
+test "a hangup drain with nothing queued returns at once" {
+    if (comptime builtin.os.tag != .linux) return error.SkipZigTest;
+    const pty = try Pty.open(.{ .ws_row = 24, .ws_col = 80, .ws_xpixel = 0, .ws_ypixel = 0 });
+    defer _ = posix.system.close(pty.master);
+    _ = posix.system.close(pty.slave);
+    try TestHangup.poll(pty.master);
+    try std.testing.expect(TestHangup.revents & posix.POLL.HUP != 0);
+    try std.testing.expect(ReadThread.setNonblock(pty.master));
+    var result = try testGather(pty.master, TestHangup.step);
+    defer result.got.deinit(std.testing.allocator);
+    try std.testing.expectEqual(@as(usize, 1), result.drained);
+    try std.testing.expectEqual(@as(usize, 0), result.got.items.len);
+}
+
+const TestHangupPoll = struct {
+    slave: ?posix.fd_t,
+    const output = "final output";
+
+    fn poll(self: *TestHangupPoll, fds: []posix.pollfd, _: i32) !usize {
+        const slave = self.slave orelse return error.TestUnexpectedPoll;
+        self.slave = null;
+        const written = posix.system.write(slave, output, output.len);
+        _ = posix.system.close(slave);
+        try std.testing.expectEqual(@as(isize, output.len), written);
+
+        const ready = try posix.poll(fds, 1000);
+        const expected = posix.POLL.IN | posix.POLL.HUP;
+        try std.testing.expectEqual(expected, fds[0].revents & expected);
+        return ready;
+    }
+};
+
+test "the gather stage drains output when its outer poll reports hangup" {
+    if (comptime builtin.os.tag != .linux) return error.SkipZigTest;
+    const pty = try Pty.open(.{ .ws_row = 24, .ws_col = 80, .ws_xpixel = 0, .ws_ypixel = 0 });
+    defer _ = posix.system.close(pty.master);
+    var outer_poll: TestHangupPoll = .{ .slave = pty.slave };
+    defer if (outer_poll.slave) |slave| {
+        _ = posix.system.close(slave);
+    };
+    try std.testing.expect(ReadThread.setNonblock(pty.master));
+
+    const alloc = std.testing.allocator;
+    const pipeline = try alloc.create(ReadThread.Pipeline);
+    defer alloc.destroy(pipeline);
+    pipeline.* = .{};
+    ReadThread.gatherMainPosix(pty.master, -1, pipeline, &outer_poll);
+
+    try std.testing.expect(pipeline.done);
+    try std.testing.expectEqual(@as(usize, 1), pipeline.count);
+    try std.testing.expectEqualStrings(TestHangupPoll.output, pipeline.bufs[0][0..pipeline.lens[0]]);
+}
+
+fn testDeadline(finished: *std.Io.Event, description: []const u8) void {
+    const io = global.io();
+    const deadline = std.Io.Clock.Timestamp.fromNow(io, .{ .raw = .fromSeconds(5), .clock = .awake });
+    while (!finished.isSet()) {
+        finished.waitTimeout(io, .{ .deadline = deadline }) catch {};
+        if (deadline.untilNow(io).raw.nanoseconds >= 0 and !finished.isSet()) {
+            std.debug.print("test deadline exceeded: {s} (5 s)\n", .{description});
+            std.process.exit(1);
+        }
+    }
+}
+
+test "a hangup drain stops at its cap when the fd never runs dry" {
+    if (comptime builtin.os.tag != .linux) return error.SkipZigTest;
+    // /dev/zero always has more to read, as a peer that keeps refilling the pty would
+    const fd = try posix.openatZ(posix.AT.FDCWD, "/dev/zero", .{ .NONBLOCK = true, .CLOEXEC = true }, 0);
+    defer _ = posix.system.close(fd);
+    var finished: std.Io.Event = .unset;
+    const watchdog = try std.Thread.spawn(.{}, testDeadline, .{ &finished, "hangup drain cap" });
+    defer {
+        finished.set(global.io());
+        watchdog.join();
+    }
+    var result = try testGather(fd, ReadThread.drainAfterHangup);
+    defer result.got.deinit(std.testing.allocator);
+    try std.testing.expect(result.drained >= ReadThread.hangup_drain_max);
+    try std.testing.expect(result.drained < ReadThread.hangup_drain_max + ReadThread.buffer_capacity);
+    try std.testing.expectEqual(result.drained, result.received);
+}
