+/// Stands in for the Termio in the parse stage: parses into a real terminal, under the mutex the exit
+/// message takes too, but only once `go` is set, so a test can hold output unparsed as a loaded host does.
+const TestParseSink = struct {
+    mutex: std.Io.Mutex = .init,
+    terminal: *terminal.Terminal,
+    stream: *terminal.TerminalStream,
+    go: std.atomic.Value(bool) = .init(false),
+    renderer_state: struct {
+        fn yieldToDemand(_: @This(), _: std.Io) void {}
+    } = .{},
+
+    fn processOutput(self: *TestParseSink, buf: []const u8) void {
+        while (!self.go.load(.acquire)) std.Thread.yield() catch {};
+        self.mutex.lockUncancelable(global.io());
+        defer self.mutex.unlock(global.io());
+        self.stream.nextSlice(buf);
+    }
+};
+
+/// Writes the exit message as Surface.childExited does when the child_exited notice arrives.
+const TestExitNotice = struct {
+    sink: *TestParseSink,
+    read_done: *const std.atomic.Value(bool),
+    count: usize = 0,
+    /// Whether the read thread was done when the notice arrived, so not released by the bound.
+    saw_read_done: bool = false,
+
+    fn deliver(self: *TestExitNotice) void {
+        self.count += 1;
+        self.saw_read_done = self.read_done.load(.acquire);
+        self.sink.mutex.lockUncancelable(global.io());
+        defer self.sink.mutex.unlock(global.io());
+        const t = self.sink.terminal;
+        t.carriageReturn();
+        t.linefeed() catch @panic("linefeed failed");
+        t.printString("Process exited. Press any key to close the terminal.") catch @panic("print failed");
+    }
+};
