+test "the exit message goes at once when the read thread is already done" {
+    var read_done: std.atomic.Value(bool) = .init(true);
+    var loop = try xev.Loop.init(.{});
+    defer loop.deinit();
+    var hold: ExitHold = .{ .read_done = &read_done, .timer = try xev.Timer.init() };
+    defer hold.timer.deinit();
+    var notice: struct {
+        count: usize = 0,
+        fn deliver(self: *@This()) void {
+            self.count += 1;
+        }
+    } = .{};
+    hold.wait(&loop, @TypeOf(notice), &notice, @TypeOf(notice).deliver);
+    try std.testing.expectEqual(@as(usize, 1), notice.count);
+}
