+/// Holds the child_exited notice until the read thread has parsed the
+/// child's last output (agterm-omarchy #447). The process watcher can
+/// report the exit while what the child wrote just before it is still
+/// queued in the pty or in the read pipeline, and the surface prints
+/// "Process exited" on the notice, so without the hold that output
+/// landed after the message. A process that inherited the pty can keep
+/// it open after the child exits, so the read thread never finishes;
+/// then the notice waits max_ms and logs a warning on delivery.
+/// The IO thread re-checks on a timer without blocking.
+const ExitHold = struct {
+    /// Set by the read thread once it has parsed everything it will
+    /// ever read.
+    read_done: *const std.atomic.Value(bool),
+
+    timer: xev.Timer,
+    c: xev.Completion = .{},
+    start: std.Io.Timestamp = undefined,
+
+    /// The longest the notice waits for the read thread.
+    const max_ms = 1000;
+
+    /// How often a held notice re-checks the read thread.
+    const poll_ms = 2;
+
+    /// Calls deliver(userdata) on the loop's thread once the read
+    /// thread is done or max_ms have passed, at once if it already is.
+    fn wait(
+        self: *ExitHold,
+        loop: *xev.Loop,
+        comptime Userdata: type,
+        userdata: *Userdata,
+        comptime deliver: fn (*Userdata) void,
+    ) void {
+        self.start = .now(global.io(), .awake);
+        self.check(loop, Userdata, userdata, deliver);
+    }
+
+    fn check(
+        self: *ExitHold,
+        loop: *xev.Loop,
+        comptime Userdata: type,
+        userdata: *Userdata,
+        comptime deliver: fn (*Userdata) void,
+    ) void {
+        const done = self.read_done.load(.acquire);
+        if (done or self.start.untilNow(global.io(), .awake).toMilliseconds() >= max_ms) {
+            if (!done) log.warn("exit hold bound reached, notice delivered before read thread finished", .{});
+            deliver(userdata);
+            return;
+        }
+
+        self.timer.run(loop, &self.c, poll_ms, Userdata, userdata, struct {
+            fn callback(
+                ud: ?*Userdata,
+                l: *xev.Loop,
+                c: *xev.Completion,
+                r: xev.Timer.RunError!void,
+            ) xev.CallbackAction {
+                // The notice must not be lost, so a failed timer
+                // delivers it at once.
+                _ = r catch |err| {
+                    log.warn("exit hold timer failed err={}", .{err});
+                    deliver(ud.?);
+                    return .disarm;
+                };
+                const hold: *ExitHold = @alignCast(@fieldParentPtr("c", c));
+                hold.check(l, Userdata, ud.?, deliver);
+                return .disarm;
+            }
+        }.callback);
+    }
+};
