+    defer {
+        finished.set(global.io());
+        watchdog.join();
+    }
+    // a process that inherited the pty keeps it open after the child exits
+    const read_done: std.atomic.Value(bool) = .init(false);
+    var loop = try xev.Loop.init(.{});
+    defer loop.deinit();
+    var hold: ExitHold = .{ .read_done = &read_done, .timer = try xev.Timer.init() };
+    defer hold.timer.deinit();
+    var notice: struct {
+        count: usize = 0,
+        fn deliver(self: *@This()) void {
+            self.count += 1;
+        }
+    } = .{};
+    const start: std.Io.Timestamp = .now(global.io(), .awake);
+    hold.wait(&loop, @TypeOf(notice), &notice, @TypeOf(notice).deliver);
