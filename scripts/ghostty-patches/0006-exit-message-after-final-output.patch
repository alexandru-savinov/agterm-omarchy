+// regression (agterm-omarchy #447): the process watcher reported the exit while the child's last output
+// was still unparsed, and the surface printed its exit message on that notice, ahead of the output
+test "the exit message waits until the last output of the child is parsed" {
+    if (comptime builtin.os.tag != .linux) return error.SkipZigTest;
+    const alloc = std.testing.allocator;
+    var t: terminal.Terminal = try .init(global.io(), alloc, .{ .cols = 80, .rows = 4 });
+    defer t.deinit(alloc);
+    var stream = t.vtStream();
+    defer stream.deinit();
+    var sink: TestParseSink = .{ .terminal = &t, .stream = &stream };
+
+    // the last output of the child, queued in a pty whose replica has closed
+    const final = "FINAL-OUTPUT";
+    const pty = try Pty.open(.{ .ws_row = 24, .ws_col = 80, .ws_xpixel = 0, .ws_ypixel = 0 });
+    defer _ = posix.system.close(pty.master);
+    try std.testing.expectEqual(@as(isize, final.len), posix.system.write(pty.slave, final, final.len));
+    _ = posix.system.close(pty.slave);
+    try std.testing.expect(ReadThread.setNonblock(pty.master));
+
+    // the read thread's two stages, the parse stage held until the exit is reported
+    const quit = try internal_os.pipe();
+    defer _ = posix.system.close(quit[0]);
+    defer _ = posix.system.close(quit[1]);
+    const pipeline = try alloc.create(ReadThread.Pipeline);
+    defer alloc.destroy(pipeline);
+    pipeline.* = .{};
+    var read_done: std.atomic.Value(bool) = .init(false);
+    var loop = try xev.Loop.init(.{});
+    defer loop.deinit();
+    var hold: ExitHold = .{ .read_done = &read_done, .timer = try xev.Timer.init() };
+    defer hold.timer.deinit();
+    var notice: TestExitNotice = .{ .sink = &sink, .read_done = &read_done };
+    {
+        const gather = try std.Thread.spawn(.{}, ReadThread.gatherMainPosix, .{ pty.master, quit[0], pipeline, posix });
+        defer gather.join();
+        const parse = try std.Thread.spawn(.{}, ReadThread.parseMainPosix, .{ &sink, pipeline, &read_done });
+        defer parse.join();
+
+        hold.wait(&loop, TestExitNotice, &notice, TestExitNotice.deliver);
+        sink.go.store(true, .release);
+        try loop.run(.until_done);
+    }
+
+    try std.testing.expectEqual(@as(usize, 1), notice.count);
+    const screen = try t.plainString(alloc);
+    defer alloc.free(screen);
+    const at_final = std.mem.indexOf(u8, screen, final) orelse return error.TestFinalOutputMissing;
+    const at_exit = std.mem.indexOf(u8, screen, "Process exited.") orelse return error.TestExitMessageMissing;
+    try std.testing.expect(at_final < at_exit);
+    try std.testing.expect(notice.saw_read_done);
+}
