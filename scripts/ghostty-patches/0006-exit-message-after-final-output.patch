+test "process exit holds the real surface mailbox notice until the reader finishes" {
+    if (comptime builtin.os.tag != .linux or apprt.runtime != apprt.none) return error.SkipZigTest;
+    const App = @import("../App.zig");
+    const Surface = @import("../Surface.zig");
+    var app: apprt.App = .{};
+    var surface: Surface = undefined;
+    var queue: App.Mailbox.Queue = .{};
+    const io = global.io();
+    var read_done: std.atomic.Value(bool) = .init(false);
+    var loop = try xev.Loop.init(.{});
+    defer loop.deinit();
+    var td: termio.Termio.ThreadData = .{
+        .alloc = std.testing.allocator,
+        .loop = &loop,
+        .renderer_state = undefined,
+        .surface_mailbox = .{
+            .surface = &surface,
+            .app = .{ .rt_app = &app, .mailbox = &queue },
+        },
+        .backend = .{ .exec = .{
+            .start = .now(io, .awake),
+            .write_stream = undefined,
+            .process = null,
+            .read_thread = undefined,
+            .read_thread_pipe = undefined,
+            .read_thread_fd = undefined,
+            .termios_timer = undefined,
+            .exit_hold = .{ .read_done = &read_done, .timer = try xev.Timer.init() },
+        } },
+        .mailbox = undefined,
+    };
+    defer td.backend.exec.exit_hold.timer.deinit();
+
+    const start: std.Io.Timestamp = .now(io, .awake);
+    processExitCommon(&td, 42);
+    try std.testing.expect(td.backend.exec.exited);
+    try std.testing.expect(queue.pop(io) == null);
+
+    read_done.store(true, .release);
+    try loop.run(.until_done);
+    try std.testing.expect(start.untilNow(io, .awake).toMilliseconds() < ExitHold.max_ms);
+    const message = queue.pop(io) orelse return error.TestExitNoticeMissing;
+    try std.testing.expect(message == .surface_message);
+    try std.testing.expectEqual(&surface, message.surface_message.surface);
+    const notice = message.surface_message.message;
+    try std.testing.expect(notice == .child_exited);
+    try std.testing.expectEqual(@as(u32, 42), notice.child_exited.exit_code);
+    try std.testing.expect(queue.pop(io) == null);
+}
