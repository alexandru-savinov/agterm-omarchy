+/// Collects one client's frames until EOF, on its own thread.
+const FrameReader = struct {
+    alloc: std.mem.Allocator,
+    fd: i32,
+    frames: ipc.SocketBuffer,
+    output: std.ArrayList(u8) = .empty,
+    roles: usize = 0,
+    final_seen: std.atomic.Value(bool) = .init(false),
+    eof_ms: std.atomic.Value(i64) = .init(0),
+
+    fn run(self: *FrameReader) void {
+        while (true) {
+            const n = self.frames.read(self.fd) catch 0;
+            if (n == 0) break;
+            while (self.frames.next()) |msg| switch (msg.header.tag) {
+                .Output => {
+                    self.output.appendSlice(self.alloc, msg.payload) catch @panic("out of memory");
+                    if (std.mem.endsWith(u8, self.output.items, EndingSession.final_mark)) self.final_seen.store(true, .release);
+                },
+                .Role => self.roles += 1,
+                else => {},
+            };
+        }
+        self.eof_ms.store(role.nowMs(), .release);
+    }
+
+    fn deinit(self: *FrameReader) void {
+        self.output.deinit(self.alloc);
+        self.frames.deinit();
+    }
+};
+
+// regression: a drained leader closed early told a follower still behind "unowned" mid-drain, and agterm
+// reattached that pane to the dying session, losing its final output. The teardown closes clients without
+// telling roles, so every Role frame a follower can read was queued before the unlink.
+test "a managed follower behind at the exit gets its last output and no role change from the drain" {
+    const alloc = std.testing.allocator;
+    var s: EndingSession = undefined;
+    try s.start(alloc, .{ .drain_ms = 20_000, .managed = true });
+    defer s.deinit();
+    const payload = try testPayload(alloc);
+    defer alloc.free(payload);
+
+    var lead: FrameReader = .{ .alloc = alloc, .fd = s.leader, .frames = try ipc.SocketBuffer.init(alloc) };
+    defer lead.deinit();
+    const lead_thread = try std.Thread.spawn(.{}, FrameReader.run, .{&lead});
+    defer lead_thread.join();
+
+    try s.shellPrintsAndExits(payload);
+    // the leader has been sent everything; give a drain that would let it go time to do so
+    const seen_by = role.nowMs() + 20_000;
+    while (!lead.final_seen.load(.acquire)) : (sleepMs(5)) {
+        if (role.nowMs() > seen_by) return error.LeaderNeverDone;
+    }
+    sleepMs(500);
+    try std.testing.expect(!EndingSession.done(&s.daemon_done_ms));
+
+    // the drained leader still waits for the teardown: no client hangs up while the socket file exists
+    try std.testing.expectEqual(@as(i64, 0), lead.eof_ms.load(.acquire));
+
+    var follow: FrameReader = .{ .alloc = alloc, .fd = s.sock, .frames = try ipc.SocketBuffer.init(alloc) };
+    defer follow.deinit();
+    // on its own thread under the watchdog, so a daemon that never closes the follower fails the test
+    const follow_thread = try std.Thread.spawn(.{}, FrameReader.run, .{&follow});
+    EndingSession.waitFor(&follow.eof_ms);
+    follow_thread.join();
+    EndingSession.waitFor(&s.daemon_done_ms);
+
+    const expected = try std.mem.concat(alloc, u8, &.{ EndingSession.start_mark, payload, EndingSession.final_mark });
+    defer alloc.free(expected);
+    if (follow.roles != 0 or !std.mem.endsWith(u8, follow.output.items, expected)) {
+        std.debug.print("the follower read {d} role frames and {d} output bytes, of {d} the shell wrote\n", .{ follow.roles, follow.output.items.len, expected.len });
+        return error.TestUnexpectedResult;
+    }
+}
