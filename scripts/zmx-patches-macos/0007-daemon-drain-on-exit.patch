+const EofRequestBatch = struct {
+    armed: std.atomic.Value(bool) = .init(false),
+    wake_sent: std.atomic.Value(bool) = .init(false),
+    observed: std.atomic.Value(bool) = .init(false),
+    same_poll: std.atomic.Value(bool) = .init(false),
+    socket_fd: i32 = -1,
+    shell_slave: *i32 = undefined,
+
+    fn prepareCurrent() ?*EofRequestBatch {
+        if (test_eof_request_batch) |batch| {
+            if (batch.prepare()) return batch;
+        }
+        return null;
+    }
+
+    fn prepare(self: *EofRequestBatch) bool {
+        if (!self.armed.swap(false, .acq_rel)) return false;
+        const deadline = role.nowMs() + 20_000;
+        while (!self.wake_sent.load(.acquire)) : (sleepOneMs()) {
+            if (role.nowMs() >= deadline) @panic("EOF request gate was not released");
+        }
+        lib_posix.close(self.shell_slave.*);
+        self.shell_slave.* = -1;
+        ipc.send(self.socket_fd, .Run, "printf SAME-EOF-RUN-MARK") catch @panic("EOF Run could not be queued");
+        ipc.send(self.socket_fd, .Info, "") catch @panic("EOF Info could not be queued");
+        return true;
+    }
+
+    fn record(self: *EofRequestBatch, descriptors: []const lib_posix.pollfd) void {
+        const eof_ready = descriptors[1].revents & (lib_posix.POLL.IN | lib_posix.POLL.HUP | lib_posix.POLL.ERR) != 0;
+        const request_ready = descriptors.len > 3 and descriptors[3].revents & lib_posix.POLL.IN != 0;
+        self.same_poll.store(eof_ready and request_ready, .release);
+        self.observed.store(true, .release);
+    }
+};
