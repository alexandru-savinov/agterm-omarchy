+extern "c" fn grantpt(fd: c_int) c_int;
+extern "c" fn unlockpt(fd: c_int) c_int;
+extern "c" fn ptsname(fd: c_int) ?[*:0]const u8;
+
+/// A raw PTY of the given size, so what is written to one side reaches the other byte for byte.
+fn testPty(rows: u16, cols: u16) ![2]i32 {
+    const master = try lib_posix.open("/dev/ptmx", .{ .ACCMODE = .RDWR, .NOCTTY = true }, 0);
+    errdefer lib_posix.close(master);
+    if (grantpt(master) != 0 or unlockpt(master) != 0) return error.PtyUnavailable;
+    const name = ptsname(master) orelse return error.PtyUnavailable;
+    const slave = try lib_posix.open(std.mem.span(name), .{ .ACCMODE = .RDWR, .NOCTTY = true }, 0);
+    errdefer lib_posix.close(slave);
+    var tio: cross.c.struct_termios = undefined;
+    if (cross.c.tcgetattr(slave, &tio) != 0) return error.PtyUnavailable;
+    cross.c.cfmakeraw(&tio);
+    if (cross.c.tcsetattr(slave, cross.c.TCSANOW, &tio) != 0) return error.PtyUnavailable;
+    var ws = std.mem.zeroes(cross.c.struct_winsize);
+    ws.ws_row = rows;
+    ws.ws_col = cols;
+    if (cross.c.ioctl(master, cross.c.TIOCSWINSZ, &ws) != 0) return error.PtyUnavailable;
+    for ([_]i32{ master, slave }) |fd| {
+        var actual = std.mem.zeroes(cross.c.struct_winsize);
+        if (cross.c.ioctl(fd, cross.c.TIOCGWINSZ, &actual) != 0 or actual.ws_row != rows or actual.ws_col != cols) {
+            return error.PtySizeUnavailable;
+        }
+    }
+    return .{ master, slave };
+}
