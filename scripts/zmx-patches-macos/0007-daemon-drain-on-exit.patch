+test "EOF and a queued Run in one poll reject the Run before draining" {
+    const alloc = std.testing.allocator;
+    var batch: EofRequestBatch = .{};
+    var session: EndingSession = undefined;
+    try session.start(alloc, .{ .drain_ms = 20_000, .eof_batch = &batch });
+    defer session.deinit();
+    var frames = try ipc.SocketBuffer.init(alloc);
+    defer frames.deinit();
+
+    batch.armed.store(true, .release);
+    const wake = try socket.sessionConnect(session.daemon.socket_path);
+    defer lib_posix.close(wake);
+    batch.wake_sent.store(true, .release);
+    const deadline = role.nowMs() + 40_000;
+    var acknowledgements: usize = 0;
+    var inventories: usize = 0;
+    while (true) {
+        var ready = [_]lib_posix.pollfd{.{ .fd = session.sock, .events = lib_posix.POLL.IN, .revents = 0 }};
+        _ = try lib_posix.poll(&ready, 100);
+        if (ready[0].revents & (lib_posix.POLL.IN | lib_posix.POLL.HUP) != 0) {
+            if (try frames.read(session.sock) == 0) break;
+            while (frames.next()) |message| switch (message.header.tag) {
+                .Ack => acknowledgements += 1,
+                .Info => inventories += 1,
+                else => {},
+            };
+        }
+        if (role.nowMs() >= deadline) return error.EofBatchTimedOut;
+    }
+    EndingSession.waitFor(&session.daemon_done_ms);
+    try std.testing.expect(batch.observed.load(.acquire));
+    try std.testing.expect(batch.same_poll.load(.acquire));
+    try std.testing.expectEqual(@as(usize, 1), inventories);
+    try std.testing.expectEqual(@as(usize, 0), acknowledgements);
+    try std.testing.expect(!session.daemon.is_task_mode);
+    try std.testing.expectEqual(@as(usize, 0), session.daemon.pty_write_buf.items.len);
+}
